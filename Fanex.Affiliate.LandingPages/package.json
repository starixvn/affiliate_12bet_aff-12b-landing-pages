{
  "name": "fanex-affiliate-landing-pages",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "watch": "sass src/scss/site.scss:wwwroot/css/site.css --watch",
    "build:dev": "sass src/scss/site.scss:wwwroot/css/site.css --style expanded --source-map",
    "build:pro": "sass src/scss/site.scss:wwwroot/css/site.css --style compressed",
    "dev": "concurrently \"npm run watch\" \"dotnet watch run\"",
    "build:js": "webpack --mode production",
    "build:js:dev": "webpack --mode development",
    "watch:js": "webpack --mode development --watch"
  },
  "dependencies": {
    "jquery": "^3.7.1",
    "jquery-validation": "^1.19.5",
    "jquery-validation-unobtrusive": "^3.2.12",
    "swiper": "^11.0.5"
  },
  "devDependencies": {
    "sass": "^1.69.0",
    "concurrently": "^8.2.2",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  }
}
