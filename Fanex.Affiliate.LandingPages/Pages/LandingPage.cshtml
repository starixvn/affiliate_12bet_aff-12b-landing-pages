@page "/p1/{languageCode}/{PageCode}"
@using Fanex.Affiliate.LandingPages.Core
@model Fanex.Affiliate.LandingPages.Pages.LandingPageModel
@{
    ViewData["Title"] = "12BET: The Complete Online Gaming Platform in India for Sports, Casino, and Slots";
    Layout = "Shared/_Layout.cshtml";
}

    @if (Model != null && Model.LandingPage != null
        && Model.LandingPage.Modules != null
        && Model.LandingPage.Modules.Any())
    {
        foreach (var module in Model.LandingPage.Modules)
        {
            string? moduleName = Enum.GetName(typeof(UiModule), module.ModuleId);
            if (!string.IsNullOrEmpty(moduleName))
            {
                @await Component.InvokeAsync(moduleName, Model)
            }
        }
    }

    @* <!-- background --> *@
    @* @await Component.InvokeAsync("Background") *@

    @* <!-- sponsor logo only --> *@
    @* @await Component.InvokeAsync("LogoSponsorship")  *@

    @* <!-- sponsor logo + register button --> *@
    @* @await Component.InvokeAsync("LogoSponsorshipRegister") *@

    @* <!-- hero image --> *@
    @* @await Component.InvokeAsync("HeroImage") *@

    @* <!-- CTA button --> *@
    @* @await Component.InvokeAsync("CTAButton") *@

    @* <!-- promo --> *@
    @* @await Component.InvokeAsync("PromoList") *@

    @* <!-- youtube --> *@
    @* @await Component.InvokeAsync("Youtube") *@

    @* <!-- fav game --> *@
    @* @await Component.InvokeAsync("FavoriteGames") *@

    @* <!-- Register form --> *@
    @* @await Component.InvokeAsync("RegistrationForm", Model) *@

<button id="goTopBtn"></button>
<div class="straight-lock-in">
    <div class="icon icon-mobile img-rotate">
        <i class="icon icon-spinner11"></i>
    </div>
    <div class="text">
        Dear Valued Customer
        <br>In order to present the better experience and products<br>
        <span class="text-org">Kindly rotate your phone in portrait for better game experience</span>
        <br>We apologize for the inconvenience caused, and hoping your utmost understanding. Thank you!
    </div>
</div>

