@page "/p1/{languageCode}/{PageCode}"
@using Fanex.Affiliate.LandingPages.Core
@model Fanex.Affiliate.LandingPages.Pages.LandingPageModel

@{
    ViewData["Title"] = "12BET: The Complete Online Gaming Platform in India for Sports, Casino, and Slots";
    Layout = "Shared/_Layout.cshtml";
}

@if (Model?.LandingPage?.Modules?.Any() == true)
{
    foreach (var module in Model.LandingPage.Modules)
    {
        var moduleName = Enum.GetName(typeof(UiModule), module.ModuleId);
        if (!string.IsNullOrWhiteSpace(moduleName))
        {
            @await Component.InvokeAsync(moduleName, Model)
        }
    }
}

