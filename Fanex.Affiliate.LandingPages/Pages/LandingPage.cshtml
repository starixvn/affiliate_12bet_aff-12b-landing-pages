@page "/p1/{languageCode}/{landingPageCode}"
@model Fanex.Affiliate.LandingPages.Pages.LandingPageModel
@{
    ViewData["Title"] = "Landing Page";
    Layout = "Shared/_Layout.cshtml";
}

<h1>Landing Page: @Model.LandingPageCode</h1>

@await Component.InvokeAsync("RegistrationForm")
@await Component.InvokeAsync("Background")
@await Component.InvokeAsync("ContactUs")
@await Component.InvokeAsync("Youtube")

@section Scripts {
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer></script>
}
