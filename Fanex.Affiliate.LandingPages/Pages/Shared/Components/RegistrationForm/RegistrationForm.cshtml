@model Fanex.Affiliate.LandingPages.Pages.LandingPageModel
@using Fanex.Affiliate.LandingPages.Core.Resources
@{
    var formConfig = Model.RegisterForm.SignUpFormConfig!;
}

<form id="register-form" class="register-form @formConfig.CssClass" method="post" autocomplete="off">
    <div class="form-content">
        <p class="form-title">@UI.Form_QuickRegistration</p>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- Username -->
        <div class="input-field">
            <div class="input-info">
                @UI.Form_UsernameHelp
            </div>
            <div class="input-box">
                <span class="required-tip" aria-label="@UI.A11y_Required">*</span>
                <input asp-for="RegisterForm.Username" placeholder="@UI.Form_Username" autocomplete="username" />
                <div class="icon-area" aria-hidden="true">
                    <i class="icon-detail icon-check-mark"></i>
                    <i class="icon-detail icon-info"></i>
                </div>
            </div>
            <span class="required-text" asp-validation-for="RegisterForm.Username"></span>
        </div>

        <!-- Password -->
        <div class="input-field">
            <div class="input-box">
                <span class="required-tip" aria-label="@UI.A11y_Required">*</span>
                <input asp-for="RegisterForm.UserPwd" placeholder="@UI.Form_Password" type="password" autocomplete="new-password" />
                <div class="icon-area" aria-hidden="true">
                    <i class="icon-detail icon-check-mark"></i>
                    <i class="icon-detail icon-eye"></i>
                    <i class="icon-detail icon-eye-slash"></i>

                </div>
            </div>
            <input asp-for="RegisterForm.Password" type="hidden" />
            <span class="required-text" asp-validation-for="RegisterForm.UserPwd"></span>
        </div>

        <!-- Phone Number -->
        <div class="input-field">
            <div class="input-box-container">
                <div class="input-box">
                    <span class="required-tip" aria-label="required">*</span>
                    <div class="dropdown-selected-container">
                        <div class="dropdown-item">@Model.RegisterForm.AreaCode</div>
                        <input asp-for="RegisterForm.AreaCode" type="hidden" />
                    </div>
                </div>
                <div class="input-box">
                    <span class="required-tip" aria-label="@UI.A11y_Required">*</span>
                    <input asp-for="RegisterForm.PhoneNo" placeholder="@UI.Form_PhoneNumber" autocomplete="tel" />
                </div>
            </div>
            <input asp-for="RegisterForm.CountryCode" type="hidden" />
            <input asp-for="RegisterForm.CurrencyId" type="hidden" />
            <span class="required-text" asp-validation-for="RegisterForm.PhoneNo"></span>
        </div>

        <!-- Country & Currency -->
        @if (formConfig.IsEnableCurrency)
        {
            <div class="input-field">
                <div class="input-box-container country-code-container">
                    <div class="input-box">
                        <span class="required-tip" aria-label="required">*</span>
                        <div class="dropdown-selected-container">
                            <div class="dropdown-item">
                                <img src="~/images/flags/@(Model.RegisterForm.CountryCode.ToLowerInvariant()).png" alt="@Model.RegisterForm.CountryCode flag" class="flag-img" />
                                @Model.RegisterForm.CountryCode
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Email -->
        @if (formConfig.IsEnableEmail)
        {
            <div class="input-field">
                <div class="input-info">
                    @UI.Validation_EmailCannotChange
                </div>
                <div class="input-box">
                    <input asp-for="RegisterForm.Email" placeholder="@UI.Form_Email" autocomplete="email" />
                    <div class="icon-area" aria-hidden="true">
                        <i class="icon-detail icon-check-mark"></i>
                        <i class="icon-detail icon-info"></i>
                    </div>
                </div>
                <span class="required-text" asp-validation-for="RegisterForm.Email"></span>
            </div>
        }

        <!-- Affiliate Code -->
        @if (formConfig.IsEnableAffiliate)
        {
            <div class="input-field">
                <div class="input-info">
                    @UI.Validation_AffiliateCannotChange
                </div>
                <div class="input-box">
                    <input asp-for="RegisterForm.AffCode" placeholder="@UI.Form_AffiliateCode" />
                    <div class="icon-area" aria-hidden="true">
                        <i class="icon-detail icon-check-mark"></i>
                        <i class="icon-detail icon-info"></i>
                    </div>
                </div>
                <span class="required-text" asp-validation-for="RegisterForm.AffCode"></span>
            </div>
        }
        else
        {
            <input asp-for="RegisterForm.AffCode" type="hidden" />
        }

        <!-- Turnstile Captcha -->
        @if (Model.LandingPage?.IsTurnstileCaptchaEnabled == true)
        {
            <div id="turnstile_widget" class="cf-turnstile"
            data-sitekey="@Model.LandingPage.TurnstileSiteKey"
            data-theme="dark"
            data-size="flexible"
            data-callback="onTurnstileSuccess"
            data-error-callback="onTurnstileError"
            data-expired-callback="onTurnstileExpired">
            </div>
        }

        <!-- Fallback Captcha -->
        <input asp-for="RegisterForm.CaptchaType" type="hidden" />
        <div id="numberCapcha" style="display:@(Model.LandingPage?.IsTurnstileCaptchaEnabled == true ? "none" : "block")">
            <div class="captcha-container">
                <img id="tokenBox" alt="captcha" style="display:none"/>
            </div>
            <div class="input-field">
                <div class="input-box">
                    <input asp-for="RegisterForm.ReCaptchaToken" placeholder="@UI.Form_Captcha" autocomplete="off" />
                    <div class="icon-area" aria-hidden="true">
                        <i class="icon-detail icon-check-mark"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit Button -->
        <button id="submit-btn" class="submit-btn" type="submit" aria-label="@UI.Form_Register">
            <span>@UI.Form_Register</span>
        </button>

        <!-- Terms and Conditions -->
        @if (formConfig.IsEnableTermsAndCondition)
        {
            var prefixTermsAgreement = string.Empty;
            var suffixTermsAgreement = string.Empty;
            var termsAgreementArr = UI.Form_TermsAgreement.Split("{0}");
            prefixTermsAgreement = termsAgreementArr[0];
            suffixTermsAgreement = termsAgreementArr[1];

            <div class="terms-conditions">
                @prefixTermsAgreement
                <a rel="noreferrer" target="_blank" href="@Model.RegisterForm.TermsConditionsURL">
                    @UI.Form_TermsAndConditions
                </a>
                @suffixTermsAgreement
            </div>
        }
    </div>
</form>