<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/swiper/swiper-bundle.min.css" />
    
    <environment include="Production">
        <link rel="stylesheet" href="~/dist/prod/site.css" asp-append-version="true" />
    </environment>
    <environment include="Development">
        <link rel="stylesheet" href="~/dist/dev/site.css" asp-append-version="true" />
    </environment>
</head>
<body>
    <div class="container">
        @RenderBody()
    </div>

    <environment include="Production">
        <script src="~/dist/dev/jquery.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/dev/vendor.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/dev/swiper.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/dev/libphonenumber-node_modules_libphonenumber-js_c.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/dev/libphonenumber-node_modules_libphonenumber-js_e.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/dev/libphonenumber-node_modules_libphonenumber-js_es6_f.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/dev/site.bundle.js" asp-append-version="true"></script>
    </environment>
    <environment include="Development">
        <script src="~/dist/prod/jquery.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/prod/vendor.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/prod/swiper.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/prod/libphonenumber-3213b867.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/prod/libphonenumber-8f257e7f.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/prod/libphonenumber-ed594eef.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/prod/site.bundle.js" asp-append-version="true"></script>
    </environment>

    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?" async defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>