@page
@model Fanex.Affiliate.LandingPages.Pages.SignUpModel;
<h2>Signup Form</h2>

<form method="post">
    <div>
        <label asp-for="Input.UserName"></label>
        <input asp-for="Input.UserName" />
    </div>
    <div>
        <label asp-for="Input.UserPwd"></label>
        <input asp-for="Input.UserPwd" type="password" />
    </div>
    <div>
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" type="email" />
    </div>
    <div>
        <label asp-for="Input.UserLang"></label>
        <input asp-for="Input.UserLang" value="en-US" />
    </div>
    <div>
        <label asp-for="Input.CurrencyId"></label>
        <input asp-for="Input.CurrencyId" type="number" value="1" />
    </div>
    <button type="submit">Sign up</button>
</form>
