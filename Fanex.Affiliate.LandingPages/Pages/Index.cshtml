@page
@model Fanex.Affiliate.LandingPages.Pages.IndexModel
@{
    ViewData["Title"] = "Affiliate Landing Pages";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">

    <title>@ViewData["Title"]</title>
    <script src="~/lib/swiper/swiper-bundle.min.js"></script>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script src="~/js/site.js"></script>
    <link rel="stylesheet" href="~/lib/swiper/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

</head>
<body class="background-img" style="background-image:url('/images/background.jpg')"> <!-- background -->
    <div class="container">
            <!-- sponsor logo only -->
        <div class="logo-sponsor-container">
            <img class="logo-sponsor"
                src="~/images/logo-sponsor.png"
                alt="logo">
        </div>

        <!-- sponsor logo + register button -->
        <div class="logo-sponsor-container">
            <img class="logo-sponsor"
                src="~/images/logo-sponsor.png"
                alt="logo">

            <button class="btn-register">
                <img src="~/images/icon-click.png"
                    alt="register icon">
                Register
            </button>
        </div>

        <!-- hero image -->
        <img class="hero-img"
            src="~/images/hero-img.png"
            alt="hero-img">

        <!-- CTA button -->
        <img class="cta-btn"
            src="~/images/cta-btn.png"
            alt="cta-btn">

        <!-- promo -->
        <img class="promo-img"
            src="~/images/Promo.png"
            alt="promo list">

        <!-- fav game -->
        <div class="swiper fav-game-swiper">
            <div class="swiper-wrapper">
                <div class="swiper-slide"><img src="~/images/fav-game.png" alt="fav-game"></div>
                <div class="swiper-slide"><img src="~/images/fav-game01.png" alt="fav-game"></div>
                <div class="swiper-slide"><img src="~/images/fav-game.png" alt="fav-game"></div>
                <div class="swiper-slide"><img src="~/images/fav-game.png" alt="fav-game"></div>
                <div class="swiper-slide"><img src="~/images/fav-game.png" alt="fav-game"></div>
            </div>

            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
            <div class="swiper-pagination"></div>
        </div>

        <!-- Register form -->
        <form class="register-form" id="register-form" novalidate>
            <div class="form-content">
                <p class="form-title">QUICK REGISTRATION</p>

                <div class="input-field">
                    <div class="input-info">For security, we suggest that your username does not contain your real name.</div>
                    <div class="input-box input-error">
                        <span class="required-tip">*</span>
                        <input type="text" name="username" placeholder="Username" autocomplete="off" required>
                        <div class="icon-area">
                            <span class="icon-detail icon-checkmark"></span>
                            <span class="icon-detail icon-information"></span>
                        </div>
                    </div>
                    <div class="required-text">Username is required.</div>
                </div>

                <div class="input-field">
                    <div class="input-box">
                        <span class="required-tip">*</span>
                        <input type="password" name="password" placeholder="Password" autocomplete="off" required>
                        <div class="icon-area">
                            <span class="icon-detail icon-checkmark"></span>
                            <span class="icon-detail icon-eye"></span>
                            <span class="icon-detail icon-eye-slash"></span>
                        </div>
                    </div>
                    <div class="required-text">Password must be 6-15 characters, contain alphanumeric.</div>
                </div>

                <div class="input-field">
                    <div class="input-box-container">
                        <div class="input-box">
                            <span class="required-tip">*</span>
                            <div class="dropdown-selected-container">
                                <div class="dropdown-item">+84</div>
                                <!-- <span class="dropdown-selected-icon"></span> -->
                            </div>
                            <!-- <div class="dropdown-container">
                                <div class="dropdown-item">+60</div>
                                <div class="dropdown-item">+66</div>
                                <div class="dropdown-item">+62</div>
                                <div class="dropdown-item">+91</div>
                                <div class="dropdown-item">+880</div>
                                <div class="dropdown-item">+86</div>
                                <div class="dropdown-item">+84</div>
                                <div class="dropdown-item">+82</div>
                                <div class="dropdown-item">+65</div>
                            </div> -->
                        </div>
                        <div class="input-box">
                            <span class="required-tip">*</span>
                            <input type="tel" name="phone" placeholder="Phone Number" autocomplete="off" required>
                        </div>
                    </div>
                    <div class="required-text">Please fill in the phone field</div>
                </div>

                <div class="input-field">
                    <div class="input-box-container country-code-container">
                    <div class="input-box">
                        <span class="required-tip">*</span>
                        <div class="dropdown-selected-container">
                            <div class="dropdown-item">
                                <img src="~/images/flag-vn.jpg" alt="vietnam" class="flag-img">
                                VN
                            </div>
                            <!-- <span class="dropdown-selected-icon"></span> -->
                        </div>
                        <!-- <div class="dropdown-container">
                            <div class="dropdown-item">
                                <img src="~/images/flag-vn.jpg" alt="vietnam" class="flag-img">
                                VN
                            </div>
                            <div class="dropdown-item">
                                <img src="~/images/flag-bdt.jpg" alt="bdt" class="flag-img">
                                BDT
                            </div>
                            <div class="dropdown-item">
                                <img src="~/images/flag-myr.jpg" alt="myr" class="flag-img">
                                MYR
                            </div>
                            <div class="dropdown-item">
                                <img src="~/images/flag-inr.jpg" alt="inr" class="flag-img">
                                INR
                            </div>
                            <div class="dropdown-item">
                                <img src="~/images/flag-thb.jpg" alt="thb" class="flag-img">
                                THB
                            </div>
                        </div> -->
                    </div>
                    </div>
                </div>

                <div class="input-field">
                    <div class="input-info">Email cannot be changed after submission.</div>
                    <div class="input-box">
                        <input type="text" name="email" placeholder="Email (Optional)" autocomplete="off" required>
                        <div class="icon-area">
                            <span class="icon-detail icon-checkmark"></span>
                            <span class="icon-detail icon-information"></span>
                        </div>
                    </div>
                    <div class="required-text">Email address format incorrect</div>
                </div>

                <div class="input-field">
                    <div class="input-info">Please enter Affiliate ID (Optional), it can not change once enter!</div>
                    <div class="input-box">
                        <input type="text" name="email" placeholder="Affiliate ID/Referral (Optional)" autocomplete="off" required>
                        <div class="icon-area">
                            <span class="icon-detail icon-checkmark"></span>
                            <span class="icon-detail icon-information"></span>
                        </div>
                    </div>
                    <div class="required-text">Affiliate ID cant be found</div>
                </div>

                <!-- Turnstile -->
                <div class="cf-turnstile"
                    data-sitekey="1x00000000000000000000AA" 
                    data-theme="dark">  <!-- light | dark -->
                </div>

                <!-- Captcha -->
                <div class="captcha-container">
                    <img src="https://dummyimage.com/150x50/cccccc/000000&text=0803"
                        alt="captcha">
                </div>

                <div class="input-field">
                    <div class="input-box">
                        <input type="text" name="captcha" placeholder="Enter captcha code" autocomplete="off" required>
                        <div class="icon-area">
                            <span class="icon-detail icon-checkmark"></span>
                        </div>
                    </div>
                </div>

                <!-- CTA button -->
                <img class="cta-btn join-now-btn"
                    src="~/images/join-now-btn.png"
                    alt="cta-btn">

                <div class="terms-conditions">
                    By clicking the Register button, I hereby acknowledge that I am above 18 years old and have read and accepted your 
                    <a rel="noreferrer" target="_blank" href="https://banner.picasso12.com/Static/en/TermsConditions.html">terms &amp; conditions</a>.
                </div>

            </div>
            </form>

    </div>

    <button id="goTopBtn"></button>

    <div class="straight-lock-in">
        <div class="icon icon-mobile img-rotate">
            <i class="icon icon-spinner11"></i>
        </div>
        <div class="text">
            Dear Valued Customer
            <br>In order to present the better experience and products<br>
            <span class="text-org">Kindly rotate your phone in portrait for better game experience</span>
            <br>We apologize for the inconvenience caused, and hoping your utmost understanding. Thank you!
        </div>
    </div>
</body>
</html> 