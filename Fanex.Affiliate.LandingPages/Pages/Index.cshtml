@page
@model Fanex.Affiliate.LandingPages.Pages.IndexModel
@using Fanex.Affiliate.LandingPages.Core.Resources
@{
    ViewData["Title"] = UI.PageTitle_Default;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">

    <title>@ViewData["Title"]</title>
    <environment include="Production">
        <link rel="stylesheet" href="~/dist/prod/site.css" asp-append-version="true" />
    </environment>
    <environment include="Development">
        <link rel="stylesheet" href="~/dist/dev/site.css" asp-append-version="true" />
    </environment>

</head>
<body>
    <div class="container">

        <!-- background -->
        <div class="background-img" style="background-image:url('/images/background.jpg')"></div>

        <!-- sponsor logo only -->
        <!-- <div class="logo-sponsor-container">
            <img class="logo-sponsor"
                src="~/images/logo-sponsor.png"
                alt="logo">
        </div> -->

        <!-- sponsor logo + register button -->
        <div class="logo-sponsor-container">
            <img class="logo-sponsor"
                src="~/images/logo-sponsor.png"
                alt="@UI.Alt_Logo">

            <button class="btn-register">
                <span class="icon-click icon"></span>
                @UI.Form_Register
            </button>
        </div>

        <!-- hero image -->
        <img class="hero-img"
            src="~/images/hero-img.png"
            alt="@UI.Alt_HeroImage">

        <!-- promo -->
        <img class="promo-img"
            src="~/images/Promo.png"
            alt="@UI.Alt_PromoList">

        <!-- CTA button -->
        <img class="cta-btn"
            src="~/images/cta-btn.png"
            alt="@UI.Alt_CTAButton">

        <!-- fav game -->
        <div class="swiper-container">
            <div class="swiper">
                <div class="swiper-wrapper">
                    <div class="swiper-slide"><img src="~/images/fav-game.png" alt="fav-game"></div>
                    <!-- <div class="swiper-slide"><img src="~/images/fav-game01.png" alt="fav-game"></div>
                    <div class="swiper-slide"><img src="~/images/fav-game.png" alt="fav-game"></div>
                    <div class="swiper-slide"><img src="~/images/fav-game.png" alt="fav-game"></div>
                    <div class="swiper-slide"><img src="~/images/fav-game.png" alt="fav-game"></div> -->
                </div>

                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
                <div class="swiper-pagination"></div>
            </div>
        </div>

        <!-- Provider -->
        <div class="swiper-container">
            <div class="swiper">
                <div class="swiper-wrapper">
                    <div class="swiper-slide"><img src="~/images/provider.png" alt="provider"></div>
                    <!-- <div class="swiper-slide"><img src="~/images/provider.png" alt="provider"></div>
                    <div class="swiper-slide"><img src="~/images/provider.png" alt="provider"></div>
                    <div class="swiper-slide"><img src="~/images/provider.png" alt="provider"></div>
                    <div class="swiper-slide"><img src="~/images/provider.png" alt="provider"></div> -->
                </div>

                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
                <div class="swiper-pagination"></div>
            </div>
        </div>

        <!-- Register form -->
        <form class="register-form theme-purple" id="register-form" novalidate>
            <div class="form-content">
                <p class="form-title">QUICK REGISTRATION</p>

                <div class="input-field">
                    <div class="input-info">@UI.Form_UsernameHelp</div>
                    <div class="input-box input-error">
                        <span class="required-tip">*</span>
                        <input type="text" name="username" placeholder="@UI.Form_Username" autocomplete="off" required>
                        <div class="icon-area">
                            <span class="icon-detail icon-checkmark"></span>
                            <span class="icon-detail icon-information"></span>
                        </div>
                    </div>
                    <div class="required-text">@UI.Validation_UsernameRequired</div>
                </div>

                <div class="input-field">
                    <div class="input-box">
                        <span class="required-tip">*</span>
                        <input type="password" name="password" placeholder="@UI.Form_Password" autocomplete="off" required>
                        <div class="icon-area">
                            <span class="icon-detail icon-checkmark"></span>
                            <span class="icon-detail icon-eye"></span>
                            <span class="icon-detail icon-eye-slash"></span>
                        </div>
                    </div>
                    <div class="required-text">@UI.Validation_PasswordRequired</div>
                </div>

                <div class="input-field">
                    <div class="input-box-container">
                        <div class="input-box">
                            <span class="required-tip">*</span>
                            <div class="dropdown-selected-container">
                                <div class="dropdown-item">+84</div>
                                <!-- <span class="dropdown-selected-icon"></span> -->
                            </div>
                            <!-- <div class="dropdown-container">
                                <div class="dropdown-item">+60</div>
                                <div class="dropdown-item">+66</div>
                                <div class="dropdown-item">+62</div>
                                <div class="dropdown-item">+91</div>
                                <div class="dropdown-item">+880</div>
                                <div class="dropdown-item">+86</div>
                                <div class="dropdown-item">+84</div>
                                <div class="dropdown-item">+82</div>
                                <div class="dropdown-item">+65</div>
                            </div> -->
                        </div>
                        <div class="input-box">
                            <span class="required-tip">*</span>
                            <input type="tel" name="phone" placeholder="@UI.Form_PhoneNumber" autocomplete="off" required>
                        </div>
                    </div>
                    <div class="required-text">@UI.Validation_PhoneRequired</div>
                </div>

                <div class="input-field">
                    <div class="input-box-container country-code-container">
                    <div class="input-box">
                        <span class="required-tip">*</span>
                        <div class="dropdown-selected-container">
                            <div class="dropdown-item">
                                <img src="~/images/flag-vn.jpg" alt="vietnam" class="flag-img">
                                VN
                            </div>
                            <!-- <span class="dropdown-selected-icon"></span> -->
                        </div>
                        <!-- <div class="dropdown-container">
                            <div class="dropdown-item">
                                <img src="~/images/flag-vn.jpg" alt="vietnam" class="flag-img">
                                VN
                            </div>
                            <div class="dropdown-item">
                                <img src="~/images/flag-bdt.jpg" alt="bdt" class="flag-img">
                                BDT
                            </div>
                            <div class="dropdown-item">
                                <img src="~/images/flag-myr.jpg" alt="myr" class="flag-img">
                                MYR
                            </div>
                            <div class="dropdown-item">
                                <img src="~/images/flag-inr.jpg" alt="inr" class="flag-img">
                                INR
                            </div>
                            <div class="dropdown-item">
                                <img src="~/images/flag-thb.jpg" alt="thb" class="flag-img">
                                THB
                            </div>
                        </div> -->
                    </div>
                    </div>
                </div>

                <div class="input-field">
                    <div class="input-info">@UI.Validation_EmailCannotChange</div>
                    <div class="input-box">
                        <input type="text" name="email" placeholder="@UI.Form_Email (Optional)" autocomplete="off" required>
                        <div class="icon-area">
                            <span class="icon-detail icon-checkmark"></span>
                            <span class="icon-detail icon-information"></span>
                        </div>
                    </div>
                    <div class="required-text">@UI.Validation_EmailFormat</div>
                </div>

                <div class="input-field">
                    <div class="input-info">@UI.Validation_AffiliateCannotChange</div>
                    <div class="input-box">
                        <input type="text" name="email" placeholder="@UI.Form_AffiliateCode (Optional)" autocomplete="off" required>
                        <div class="icon-area">
                            <span class="icon-detail icon-checkmark"></span>
                            <span class="icon-detail icon-information"></span>
                        </div>
                    </div>
                    <div class="required-text">@UI.Validation_AffiliateNotFound</div>
                </div>

                <!-- Turnstile -->
                <div class="cf-turnstile"
                    data-sitekey="1x00000000000000000000AA" 
                    data-theme="dark">  <!-- light | dark -->
                </div>

                <!-- Captcha -->
                <div class="captcha-container">
                    <img src="https://dummyimage.com/150x50/cccccc/000000&text=0803"
                        alt="captcha">
                </div>

                <div class="input-field">
                    <div class="input-box">
                        <input type="text" name="captcha" placeholder="@UI.Form_Captcha" autocomplete="off" required>
                        <div class="icon-area">
                            <span class="icon-detail icon-checkmark"></span>
                        </div>
                    </div>
                </div>

                <!-- CTA button -->
                <img class="cta-btn join-now-btn"
                    src="~/images/join-now-btn.png"
                    alt="cta-btn">

                <div class="terms-conditions">
                    @UI.Form_TermsAgreement 
                    <a rel="noreferrer" target="_blank" href="https://banner.picasso12.com/Static/en/TermsConditions.html">@UI.Form_TermsAndConditions</a>.
                </div>
            </div>
        </form>

        <!-- Login -->
        <div class="login-container">
            <a href="#" target="_blank" rel="noopener noreferrer">
                <img class="login-img" src="~/images/login-img.png" alt="login">
            </a>
        </div>

        <!-- youtube -->
        @* <div class="video-container"> *@
        @*     <iframe  *@
        @*         src="https://www.youtube.com/embed/KnTcPPx9rP8?start=7&autoplay=1&mute=1" *@
        @*         title="YouTube video player"  *@
        @*         frameborder="0" *@
        @*         allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" *@
        @*         allowfullscreen> *@
        @*     </iframe> *@
        @* </div> *@


        <!-- Contact us -->
        <div class="contact-us">
            <a href="#" target="_blank" rel="noopener noreferrer" class="contact-us-link">
                <img
                src="~/images/contact-us.png"
                    alt="@UI.Alt_ContactUs">
            </a>
        </div>

        <!-- Payment method -->
        <img class="payment-method-img"
            src="~/images/payment-method.png"
            alt="@UI.Alt_PaymentMethod">

        <!-- Licensee awards -->
        <img class="licensee-awards-img"
            src="~/images/licensed-awards.png"
            alt="@UI.Alt_LicenseeAwards">

        <!-- Go to top button -->
        <div class="scroll-to-top" id="goTopBtn" aria-label="@UI.A11y_ScrollToTop">
            <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                <path fill="#ffffff"
                d="M487.463,216.139L286.099,12.576C278.137,4.52,267.308,0,255.997,0
                    c-11.312,0-22.13,4.52-30.092,12.576L24.541,216.139c-16.438,16.622-16.304,
                    43.437,0.329,59.875c16.613,16.438,43.416,16.294,59.854-0.329l128.955-130.352v324.341
                    c0,23.362,18.945,42.327,42.318,42.327c23.382,0,42.327-18.965,42.327-42.327V145.332
                    L427.27,275.684c16.438,16.623,43.252,16.767,59.864,0.329
                    C503.758,259.576,503.901,232.761,487.463,216.139z"/>
            </svg>
        </div>

        <div class="straight-lock-in">
            <div class="icon icon-mobile img-rotate">
                <i class="icon icon-spinner11"></i>
            </div>
            <div class="text">
                @UI.Mobile_DearCustomer
                <br>@UI.Mobile_BetterExperience<br>
                <span class="text-org">@UI.Mobile_RotatePhone</span>
                <br>@UI.Mobile_Apologize
            </div>
        </div>
    </div>
    <environment include="Development">
        <script src="~/dist/dev/jquery.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/dev/vendor.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/dev/swiper.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/dev/libphonenumber-node_modules_libphonenumber-js_c.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/dev/libphonenumber-node_modules_libphonenumber-js_e.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/dev/libphonenumber-node_modules_libphonenumber-js_es6_f.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/dev/site.bundle.js" asp-append-version="true"></script>
    </environment>
    <environment include="Production">
        <script src="~/dist/prod/jquery.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/prod/vendor.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/prod/swiper.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/prod/libphonenumber-3213b867.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/prod/libphonenumber-8f257e7f.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/prod/libphonenumber-ed594eef.bundle.js" asp-append-version="true"></script>
        <script src="~/dist/prod/site.bundle.js" asp-append-version="true"></script>
    </environment>
</body>
</html>